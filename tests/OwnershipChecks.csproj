<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\.local\references</BepInExCore>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == ''">C:\Steam Games\steamapps\common\Sailwind</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\SpeedOwnership.cs" Link="SpeedOwnership.cs" />
    <Compile Include="..\src\HotkeyInput.cs" Link="HotkeyInput.cs" />
    <Compile Include="..\src\BackgroundExecution.cs" Link="BackgroundExecution.cs" />
    <Compile Include="..\src\AutosaveState.cs" Link="AutosaveState.cs" />
    <Compile Include="..\src\AutosavePatch.cs" Link="AutosavePatch.cs" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCore)\Mono.Cecil.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\Sailwind_Data\Managed\Assembly-CSharp.dll" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.CoreModule.dll" />
  </ItemGroup>
</Project>
